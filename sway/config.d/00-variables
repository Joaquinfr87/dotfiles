# ==============================================================================
# 00 - Global variables & palette (Gruvbox Material Dark)
# ==============================================================================
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Default applications
set $term kitty
set $web-browser zen

# tmux sessionizer (see tmux/README.md)
set $sessionizer tmux-sessionizer

# Font (window titles and Sway UI)
set $font pango:IosevkaTerm Nerd Font, Noto Color Emoji 10

# Noctalia IPC
set $ipc noctalia msg

# Colors (Gruvbox + transparencies: E6=90%, 80=50%, CC=80%, B3=70%)
set $bg0    #282828
set $bg1    #3c3836
set $fg     #ebdbb2
set $green  #b8bb26
set $blue   #83a598
set $yellow #fabd2f
set $gray   #928374
set $red    #fb4934
set $magenta #d3869b
set $cyan   #8ec07c
set $white  #ebdbb2
set $orange #fe8019
