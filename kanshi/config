# ==============================================================================
# Kanshi — Dynamic display configuration
# ==============================================================================
# Automatically activates the right profile when a display is connected/disconnected.
# Docs: man 5 kanshi
#
# Flow:
#   1. Laptop only → "laptop" profile (1366x768)
#   2. Laptop + HDMI → "presentation" profile (external 1920x1080 on the right)
#   3. HDMI only → "desktop_hdmi" profile (1920x1080)
#
# If you connect a different display, kanshi uses the profile that matches best.
# If none match, sway uses its default configuration.

# --- 1. Laptop only (1366x768) ---
profile laptop {
    output eDP-1 enable position 0,0 mode 1366x768@60Hz
}

# --- 2. Laptop + external HDMI display (Presentation / Dual) ---
# The external display is placed to the right of the laptop (1366,0).
profile presentation {
    output eDP-1 enable position 0,0 mode 1366x768@60Hz
    output HDMI-A-1 enable position 1366,0 mode 1920x1080@60Hz
    exec swaymsg workspace 1, move workspace to HDMI-A-1
}

# --- 3. Laptop + external DisplayPort display (USB-C / Thunderbolt dock) ---
profile laptop_dp {
    output eDP-1 enable position 0,0 mode 1366x768@60Hz
    output DP-1 enable position 1366,0 mode 1920x1080@60Hz
    exec swaymsg workspace 1, move workspace to DP-1
}

# --- 4. Laptop with lid closed + HDMI display (Clamshell) ---
profile laptop_clamshell {
    output eDP-1 disable
    output HDMI-A-1 enable position 0,0 mode 1920x1080@60Hz
}

# --- 5. Desktop PC: single HDMI monitor (1920x1080) ---
profile desktop_hdmi {
    output HDMI-A-1 enable position 0,0 mode 1920x1080@60Hz
}

# --- 6. Desktop PC: single DisplayPort monitor (1920x1080) ---
profile desktop_dp {
    output DP-1 enable position 0,0 mode 1920x1080@60Hz
}

profile desktop_dp2 {
    output DP-2 enable position 0,0 mode 1920x1080@60Hz
}

# --- 7. Desktop PC: dual monitor (primary DP + secondary HDMI) ---
profile desktop_dual {
    output DP-1 enable position 0,0 mode 1920x1080@60Hz
    output HDMI-A-1 enable position 1920,0 mode 1920x1080@60Hz
    exec swaymsg workspace 1, move workspace to DP-1
}
