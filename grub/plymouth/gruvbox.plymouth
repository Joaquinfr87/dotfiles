# ==============================================================================
# Gruvbox Plymouth theme (Debian 13)
# ==============================================================================
# Uses Plymouth's built-in two-step module and the spinner animation frames
# shipped with plymouth-themes. The installer copies those frames next to this
# file, so there is no custom image or script to maintain.

[Plymouth Theme]
Name=Gruvbox
Description=Gruvbox boot splash for Debian 13
ModuleName=two-step

[two-step]
Font=Iosevka 12
TitleFont=Iosevka 30
ImageDir=/usr/share/plymouth/themes/gruvbox
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.55
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.96
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x282828
BackgroundEndColor=0x1d2021
ProgressBarBackgroundColor=0x3c3836
ProgressBarForegroundColor=0xb8bb26
MessageBelowAnimation=true
Title=Debian GNU/Linux
SubTitle=Starting...

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
