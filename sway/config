# ------------------------------------------------------------------------------
# 4. Autoarranque (Autostart)
# ------------------------------------------------------------------------------
# Fondo de pantalla , waybar , mako
exec_always swaybg -i ~/Pictures/wallpaper5.png
exec waybar
exec_always mako
## Autostart Applications

exec swaymsg "workspace 1; exec firefox"
exec swaymsg "workspace 2; exec kitty --hold -e fastfetch"
exec swaymsg "workspace 3"

# Set XDG_CURRENT_DESKTOP for proper Wayland support
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# --- Configuración de Tema Oscuro ---
set $gnome-schema org.gnome.desktop.interface

exec_always {
    gsettings set $gnome-schema gtk-theme 'Adwaita-dark'
    gsettings set $gnome-schema color-scheme 'prefer-dark'
}

