#!/usr/bin/env bash
# ==============================================================================
# dot-sync — Sincronizador inteligente de dotfiles (sin GNU Stow)
# ==============================================================================
# Permite:
#   dot-sync deploy [desktop|server]  -> Copia dotfiles del repo al sistema (con backup)
#   dot-sync save [desktop|server]    -> Copia configs modificadas del sistema al repo
#   dot-sync diff                     -> Muestra diferencias entre repo y sistema
#   dot-sync status                   -> Estado resumido de diferencias
# ==============================================================================
set -euo pipefail

# Colores
BOLD='\033[1m'
GREEN='\033[38;5;142m'
BLUE='\033[38;5;109m'
YELLOW='\033[38;5;214m'
RED='\033[38;5;167m'
NC='\033[0m'

# Directorio del repositorio de dotfiles
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_ROOT="$HOME/.dotfiles_backup"

log_info() { echo -e "${BLUE}==>${NC} ${BOLD}$*${NC}"; }
log_ok() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[AVISO]${NC} $*"; }
log_err() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Detección del perfil
detect_profile() {
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    echo "$DOTFILES_PROFILE"
  elif [[ -f "$HOME/.dotfiles_profile" ]]; then
    cat "$HOME/.dotfiles_profile"
  elif command -v sway >/dev/null 2>&1 || [[ -d "$HOME/.config/sway" ]]; then
    echo "desktop"
  else
    echo "server"
  fi
}

PROFILE="${2:-$(detect_profile)}"

# Listas de configuración según perfil
# Formato: "ruta_en_repo:ruta_en_sistema"
get_items() {
  local prof=$1
  local items=(
    # Núcleo común (Servidor + Desktop)
    ".zshrc:$HOME/.zshrc"
    ".zprofile:$HOME/.zprofile"
    "git/config:$HOME/.config/git/config"
    "git/ignore:$HOME/.config/git/ignore"
    "tmux/tmux.conf:$HOME/.config/tmux/tmux.conf"
    "tmux/scripts/tmux-sessionizer:$HOME/.local/bin/tmux-sessionizer"
    "bin/tmux-sessionizer:$HOME/.local/bin/tmux-sessionizer"
    "bin/dot-sync:$HOME/.local/bin/dot-sync"
    "nvim:$HOME/.config/nvim"
    "starship/starship.toml:$HOME/.config/starship.toml"
  )

  if [[ "$prof" == "desktop" ]]; then
    items+=(
      "sway:$HOME/.config/sway"
      "noctalia/config.toml:$HOME/.config/noctalia/config.toml"
      "noctalia/settings.toml:$HOME/.local/state/noctalia/settings.toml"
      "kanshi:$HOME/.config/kanshi"
      "kitty:$HOME/.config/kitty"
      "Pictures:$HOME/Pictures"
    )
  fi

  printf '%s\n' "${items[@]}"
}

# Crear backup de un archivo o directorio
backup_target() {
  local target=$1
  local backup_dir=$2

  if [[ -e "$target" ]]; then
    local rel_path="${target#"$HOME"/}"
    local dest="$backup_dir/$rel_path"
    mkdir -p "$(dirname "$dest")"
    cp -r "$target" "$dest"
  fi
}

cmd_deploy() {
  log_info "Desplegando dotfiles (Perfil: $PROFILE)..."
  local timestamp
  timestamp="$(date +'%Y%m%d_%H%M%S')"
  local current_backup="$BACKUP_ROOT/$timestamp"

  mkdir -p "$HOME/.config" "$HOME/.local/bin"

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" ]]; then
      continue
    fi

    # Backup previo si existe en destino
    if [[ -e "$sys_target" ]]; then
      backup_target "$sys_target" "$current_backup"
    fi

    # Asegurar directorio padre
    mkdir -p "$(dirname "$sys_target")"

    # Copiar archivo o directorio
    if [[ -d "$src" ]]; then
      rm -rf "$sys_target"
      cp -r "$src" "$sys_target"
    else
      if [[ "$repo_rel" == "noctalia/settings.toml" && -n "$HOME" ]]; then
        sed "s|/home/[^/]*|$HOME|g" "$src" > "$sys_target"
      else
        cp -f "$src" "$sys_target"
      fi
      # Si es binario o script, dar permisos de ejecución
      if [[ "$sys_target" == *"/bin/"* ]]; then
        chmod +x "$sys_target"
      fi
    fi

    log_ok "Copiado: $repo_rel -> $sys_target"
  done < <(get_items "$PROFILE")

  # Guardar perfil seleccionado
  echo "$PROFILE" > "$HOME/.dotfiles_profile"

  if [[ -d "$current_backup" ]]; then
    log_info "Backup guardado en: $current_backup"
  fi
  log_ok "Despliegue completado con éxito."
}

cmd_save() {
  log_info "Guardando cambios del sistema en el repositorio (Perfil: $PROFILE)..."

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local dest="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$sys_target" ]]; then
      continue
    fi

    mkdir -p "$(dirname "$dest")"

    if [[ -d "$sys_target" ]]; then
      # Directorio: copiar preservando archivos limpios
      rm -rf "$dest"
      cp -r "$sys_target" "$dest"
    else
      cp -f "$sys_target" "$dest"
    fi

    log_ok "Guardado en repo: $sys_target -> $repo_rel"
  done < <(get_items "$PROFILE")

  log_ok "Configuraciones guardadas en $DOTFILES_DIR."
  log_info "Ejecuta 'git status' o 'git diff' para revisar y commitear tus cambios."
}

cmd_diff() {
  log_info "Comparando repositorio con el sistema..."
  local found_diff=0

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" && ! -e "$sys_target" ]]; then
      continue
    elif [[ ! -e "$src" ]]; then
      log_warn "Solo existe en el sistema: $sys_target"
      found_diff=1
      continue
    elif [[ ! -e "$sys_target" ]]; then
      log_warn "Solo existe en el repo: $repo_rel"
      found_diff=1
      continue
    fi

    if [[ -f "$src" && -f "$sys_target" ]]; then
      if ! diff -u "$src" "$sys_target" >/dev/null 2>&1; then
        echo -e "\n${YELLOW}=== Diferencias en: $repo_rel <-> $sys_target ===${NC}"
        diff -u --color=auto "$src" "$sys_target" || true
        found_diff=1
      fi
    elif [[ -d "$src" && -d "$sys_target" ]]; then
      if ! diff -ru -x ".git" -x "lazy-lock.json" "$src" "$sys_target" >/dev/null 2>&1; then
        echo -e "\n${YELLOW}=== Diferencias en carpeta: $repo_rel <-> $sys_target ===${NC}"
        diff -ru --color=auto -x ".git" -x "lazy-lock.json" "$src" "$sys_target" || true
        found_diff=1
      fi
    fi
  done < <(get_items "$PROFILE")

  if [[ $found_diff -eq 0 ]]; then
    log_ok "No hay diferencias: el repositorio y el sistema están sincronizados."
  fi
}

cmd_status() {
  log_info "Estado de sincronización (Perfil: $PROFILE):"
  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" && ! -e "$sys_target" ]]; then
      continue
    elif [[ ! -e "$sys_target" ]]; then
      echo -e "  ${RED}Falta en sistema${NC} : $repo_rel"
    elif [[ ! -e "$src" ]]; then
      echo -e "  ${YELLOW}Falta en repo${NC}    : $sys_target"
    elif diff -rq "$src" "$sys_target" >/dev/null 2>&1; then
      echo -e "  ${GREEN}Sincronizado${NC}    : $repo_rel"
    else
      echo -e "  ${YELLOW}Modificado${NC}      : $repo_rel (difiere del sistema)"
    fi
  done < <(get_items "$PROFILE")
}

case "${1:-status}" in
  deploy|push|install)
    cmd_deploy
    ;;
  save|pull)
    cmd_save
    ;;
  diff)
    cmd_diff
    ;;
  status)
    cmd_status
    ;;
  help|--help|-h)
    echo "Uso: dot-sync [comando] [perfil]"
    echo ""
    echo "Comandos:"
    echo "  deploy [perfil]  Copia configs del repo al sistema (con backup en ~/.dotfiles_backup)"
    echo "  save [perfil]    Copia configs del sistema hacia el repositorio"
    echo "  diff             Muestra las diferencias línea por línea"
    echo "  status           Muestra el estado de sincronización (sincronizado/modificado)"
    echo ""
    echo "Perfiles disponibles: 'desktop' (Sway + Wayland + Terminal) o 'server' (Solo CLI)"
    ;;
  *)
    log_err "Comando desconocido: $1. Usa 'dot-sync help'."
    exit 1
    ;;
esac
