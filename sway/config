# ==============================================================================
# SWAY CONFIGURATION FILE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables Globales & Tematización (Gruvbox Material Dark)
# ------------------------------------------------------------------------------
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Aplicaciones por defecto
set $term kitty
set $menu wofi --show drun

# Colores (Gruvbox + Transparencias: E6=90%, 80=50%, CC=80%, B3=70%)
set $bg0    #282828
set $bg1    #3c3836
set $fg     #ebdbb2
set $green  #b8bb26
set $blue   #83a598
set $yellow #fabd2f
set $gray   #928374
set $red    #fb4934
set $magenta #d3869b
set $cyan   #8ec07c
set $white  #ebdbb2
set $orange #fe8019

include /etc/sway/config-vars.d/*


# ------------------------------------------------------------------------------
# 2. Configuración de Hardware (Output & Input)
# ------------------------------------------------------------------------------
# Pantalla
set $laptop eDP-1
set $externo HDMI-A-1
set $res_laptop 1366x768
output $laptop res $res_laptop@60Hz
output eDP-1 res 1366x768

# Definimos el nombre del modo (se mostrará en tu barra, ej. Waybar)
# set $mode_display "Pantallas: [M]irror, [E]xterna, [D]esconectar"
set $mode_display "Pantallas: [E]xterna, [D]esconectar"

mode $mode_display {
    # 'm' para Mirror (superpone ambas pantallas en 0,0)
    # bindsym m exec swaymsg output $externo enable pos 0 0 res $res_laptop, mode "default"

    # 'e' para Externo 
    bindsym e exec swaymsg output $externo enable pos 0 0, output $laptop disable, mode "default"

    # 'd' para Desconectar lógicamente el monitor externo (ahorra energía si sigue enchufado)
    bindsym d exec swaymsg output $externo disable,output $laptop enable, mode "default"

    # 'add

    # Teclas para cancelar y volver al modo normal
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+p mode "default"
}

# Atajo para invocar el modo (ej. Super + p)
bindsym $mod+p mode $mode_display

# Touchpad
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# Cursor

seat * hide_cursor 2000 

# ------------------------------------------------------------------------------
# 3. Apariencia y Comportamiento de Ventanas (Gaps & Borders)
# ------------------------------------------------------------------------------
# Fuente para los títulos de las ventanas y la barra por defecto (si no usas Waybar)
font pango:IosevkaTerm Nerd Font, Noto Color Emoji 10
# Focused window (active)
client.focused $cyan $bg1 $fg $yellow $cyan

# Unfocused window (inactive)
client.unfocused $bg0 $bg1 $gray $bg0 $bg1

# Urgent window (e.g., alerts)
client.urgent $yellow $bg1 $fg $yellow $yellow

# Borders and Gaps.

gaps inner 4
gaps outer 4
smart_borders on
#smart_gaps on
default_border pixel 2

titlebar_padding 8 2
titlebar_border_thickness 2
#
default_border pixel 2
default_floating_border pixel 2


# # Aplicación de colores: clase | borde | fondo | texto | indicador | child_border
