#!/usr/bin/env bash
# ==============================================================================
# dot-sync — Smart dotfiles synchronizer (no GNU Stow)
# ==============================================================================
# Usage:
#   dot-sync deploy [desktop|server]  -> Copy repo dotfiles to the system (with backup)
#   dot-sync save [desktop|server]    -> Copy modified system configs back to the repo
#   dot-sync diff                     -> Show differences between repo and system
#   dot-sync status                   -> Summarized synchronization status
# ==============================================================================
set -euo pipefail

# Colors
BOLD='\033[1m'
GREEN='\033[38;5;142m'
BLUE='\033[38;5;109m'
YELLOW='\033[38;5;214m'
RED='\033[38;5;167m'
NC='\033[0m'

# Dotfiles repository directory
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_ROOT="$HOME/.dotfiles_backup"

log_info() { echo -e "${BLUE}==>${NC} ${BOLD}$*${NC}"; }
log_ok() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_err() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Profile detection
detect_profile() {
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    echo "$DOTFILES_PROFILE"
  elif [[ -f "$HOME/.dotfiles_profile" ]]; then
    cat "$HOME/.dotfiles_profile"
  elif command -v sway >/dev/null 2>&1 || [[ -d "$HOME/.config/sway" ]]; then
    echo "desktop"
  else
    echo "server"
  fi
}

PROFILE="${2:-$(detect_profile)}"

# Configuration lists per profile
# Format: "repo_path:system_path"
get_items() {
  local prof=$1
  local items=(
    # Core items (server + desktop)
    ".zshrc:$HOME/.zshrc"
    ".zprofile:$HOME/.zprofile"
    "git/config:$HOME/.config/git/config"
    "git/ignore:$HOME/.config/git/ignore"
    "tmux/tmux.conf:$HOME/.config/tmux/tmux.conf"
    "bin/tmux-sessionizer:$HOME/.local/bin/tmux-sessionizer"
    "bin/dot-sync:$HOME/.local/bin/dot-sync"
    "nvim:$HOME/.config/nvim"
    "starship/starship.toml:$HOME/.config/starship.toml"
    "environment.d/10-path.conf:$HOME/.config/environment.d/10-path.conf"
  )

  if [[ "$prof" == "desktop" ]]; then
    items+=(
      "sway:$HOME/.config/sway"
      "noctalia/config.toml:$HOME/.config/noctalia/config.toml"
      "noctalia/settings.toml:$HOME/.local/state/noctalia/settings.toml"
      "noctalia/settings.toml:$HOME/.config/noctalia/settings.toml"
      "kanshi:$HOME/.config/kanshi"
      "kitty:$HOME/.config/kitty"
      "Pictures:$HOME/Pictures"
    )
  fi

  printf '%s\n' "${items[@]}"
}

# Back up a file or directory
backup_target() {
  local target=$1
  local backup_dir=$2

  if [[ -e "$target" ]]; then
    local rel_path="${target#"$HOME"/}"
    local dest="$backup_dir/$rel_path"
    mkdir -p "$(dirname "$dest")"
    cp -r "$target" "$dest"
  fi
}

cmd_deploy() {
  log_info "Deploying dotfiles (profile: $PROFILE)..."
  local timestamp
  timestamp="$(date +'%Y%m%d_%H%M%S')"
  local current_backup="$BACKUP_ROOT/$timestamp"

  mkdir -p "$HOME/.config" "$HOME/.local/bin"

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" ]]; then
      continue
    fi

    # Back up the destination if it already exists
    if [[ -e "$sys_target" ]]; then
      backup_target "$sys_target" "$current_backup"
    fi

    # Make sure the parent directory exists
    mkdir -p "$(dirname "$sys_target")"

    # Copy file or directory
    if [[ -d "$src" ]]; then
      rm -rf "$sys_target"
      cp -r "$src" "$sys_target"
    else
      rm -f "$sys_target" 2>/dev/null || true
      if [[ "$repo_rel" == "noctalia/settings.toml" && -n "$HOME" ]]; then
        sed "s|/home/[^/]*|$HOME|g" "$src" > "$sys_target"
      else
        cp -f "$src" "$sys_target"
      fi
      # Give executable permissions to binaries and scripts
      if [[ "$sys_target" == *"/bin/"* ]]; then
        chmod +x "$sys_target"
      fi
    fi

    log_ok "Copied: $repo_rel -> $sys_target"
  done < <(get_items "$PROFILE")

  # Save the selected profile
  echo "$PROFILE" > "$HOME/.dotfiles_profile"

  if [[ -d "$current_backup" ]]; then
    log_info "Backup saved to: $current_backup"
  fi
  log_ok "Deployment completed successfully."
}

cmd_save() {
  log_info "Saving system changes back to the repository (profile: $PROFILE)..."

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local dest="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$sys_target" ]]; then
      continue
    fi

    mkdir -p "$(dirname "$dest")"

    if [[ -d "$sys_target" ]]; then
      # Directory: copy it, preserving clean files
      rm -rf "$dest"
      cp -r "$sys_target" "$dest"
    else
      cp -f "$sys_target" "$dest"
    fi

    log_ok "Saved to repo: $sys_target -> $repo_rel"
  done < <(get_items "$PROFILE")

  log_ok "Configurations saved to $DOTFILES_DIR."
  log_info "Run 'git status' or 'git diff' to review and commit your changes."
}

cmd_diff() {
  log_info "Comparing the repository with the system..."
  local found_diff=0

  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" && ! -e "$sys_target" ]]; then
      continue
    elif [[ ! -e "$src" ]]; then
      log_warn "Only exists on the system: $sys_target"
      found_diff=1
      continue
    elif [[ ! -e "$sys_target" ]]; then
      log_warn "Only exists in the repo: $repo_rel"
      found_diff=1
      continue
    fi

    if [[ -f "$src" && -f "$sys_target" ]]; then
      if ! diff -u "$src" "$sys_target" >/dev/null 2>&1; then
        echo -e "\n${YELLOW}=== Differences in file: $repo_rel <-> $sys_target ===${NC}"
        diff -u --color=auto "$src" "$sys_target" || true
        found_diff=1
      fi
    elif [[ -d "$src" && -d "$sys_target" ]]; then
      if ! diff -ru -x ".git" -x "lazy-lock.json" "$src" "$sys_target" >/dev/null 2>&1; then
        echo -e "\n${YELLOW}=== Differences in directory: $repo_rel <-> $sys_target ===${NC}"
        diff -ru --color=auto -x ".git" -x "lazy-lock.json" "$src" "$sys_target" || true
        found_diff=1
      fi
    fi
  done < <(get_items "$PROFILE")

  if [[ $found_diff -eq 0 ]]; then
    log_ok "No differences: the repository and the system are in sync."
  fi
}

cmd_status() {
  log_info "Synchronization status (profile: $PROFILE):"
  while IFS=':' read -r repo_rel sys_target; do
    [[ -z "$repo_rel" ]] && continue
    local src="$DOTFILES_DIR/$repo_rel"

    if [[ ! -e "$src" && ! -e "$sys_target" ]]; then
      continue
    elif [[ ! -e "$sys_target" ]]; then
      echo -e "  ${RED}Missing on system${NC} : $repo_rel"
    elif [[ ! -e "$src" ]]; then
      echo -e "  ${YELLOW}Missing in repo${NC}   : $sys_target"
    elif diff -rq "$src" "$sys_target" >/dev/null 2>&1; then
      echo -e "  ${GREEN}In sync${NC}           : $repo_rel"
    else
      echo -e "  ${YELLOW}Modified${NC}          : $repo_rel (differs from the system)"
    fi
  done < <(get_items "$PROFILE")
}

case "${1:-status}" in
  deploy|push|install)
    cmd_deploy
    ;;
  save|pull)
    cmd_save
    ;;
  diff)
    cmd_diff
    ;;
  status)
    cmd_status
    ;;
  help|--help|-h)
    echo "Usage: dot-sync [command] [profile]"
    echo ""
    echo "Commands:"
    echo "  deploy [profile]  Copy configs from the repo to the system (backup in ~/.dotfiles_backup)"
    echo "  save [profile]    Copy configs from the system back into the repository"
    echo "  diff              Show line-by-line differences"
    echo "  status            Show sync status (in sync/modified)"
    echo ""
    echo "Available profiles: 'desktop' (Sway + Wayland + Terminal) or 'server' (CLI only)"
    ;;
  *)
    log_err "Unknown command: $1. Use 'dot-sync help'."
    exit 1
    ;;
esac
