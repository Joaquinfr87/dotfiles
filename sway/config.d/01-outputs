# ==============================================================================
# 01 - Outputs (displays)
# ==============================================================================
# Output name variables (useful in other files)
set $laptop eDP-1
set $external HDMI-A-1
set $res_laptop 1366x768
set $res_desktop 1920x1080

# Laptop base configuration (1366x768)
output $laptop resolution $res_laptop@60Hz position 0,0

# Desktop / external monitor base configuration (1920x1080)
# (Kanshi dynamically manages positions and profiles)
output $external resolution $res_desktop@60Hz
output DP-1 resolution $res_desktop@60Hz
output DP-2 resolution $res_desktop@60Hz

# Kanshi automatically manages external displays.
# If you need to force something manually, use:
#   swaymsg output HDMI-A-1 enable pos 1366,0 mode 1920x1080@60Hz

# --- XWayland (X11 apps) -----------------------------------------------------
# enable = on demand: Xwayland starts when the first X11 app connects.
# Requires the "xwayland" package; without it this block has no effect.
# With Xwayland active, the [window_type=...] rules in 05-floating come alive.
xwayland enable
