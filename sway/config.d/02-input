# ==============================================================================
# 02 - Input (keyboard, touchpad, cursor)
# ==============================================================================
input type:keyboard {
    repeat_delay 250
    repeat_rate 50
    xkb_layout "us"
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# Hide the cursor after 2 seconds of inactivity
seat * hide_cursor 2000
