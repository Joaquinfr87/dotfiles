#!/usr/bin/env bash
# ==============================================================================
# tmux-sessionizer — pick a session or folder with fzf and jump to it
# ==============================================================================
# fzf menu with three modes:
#   ctrl-s: **existing tmux sessions** (default)
#   ctrl-t: projects (first level of the search roots)
#   ctrl-a: any folder in $HOME (up to `any_depth` levels)
#
# Picking a session **switches to it**; picking a folder creates (or
# reuses) a session named after the folder.
#
# Project roots:
#   1. First level of `search_dirs` (below).
#   2. First level of every path in ~/.config/tmux/sessionizer.dirs
#      (one per line; `~`, `#` comments and blank lines are supported).
#      Useful for adding folders without touching the dotfiles.
#
# Works the same from outside tmux (sway/kitty) and from inside it
# (prefix + f).
set -euo pipefail

search_dirs=("$HOME/repos" "$HOME/Downloads")
config_file="${TMUX_SESSIONIZER_DIRS:-$HOME/.config/tmux/sessionizer.dirs}"
any_depth=5

# --- Search roots: defaults + config, without duplicates ----------------
declare -A seen=()
roots=()
add_root() {
  local d=$1
  [[ -d $d && -z ${seen[$d]+x} ]] || return 0
  seen[$d]=1
  roots+=("$d")
}

for d in "${search_dirs[@]}"; do
  add_root "$d"
done

if [[ -f $config_file ]]; then
  while IFS= read -r d || [[ -n $d ]]; do
    d=${d%$'\r'}
    [[ -z $d || $d == \#* ]] && continue
    [[ $d == \~* ]] && d=$HOME${d#\~}
    add_root "$d"
  done < "$config_file"
fi

# --- fzf listings -------------------------------------------------------
# The `_cmd` variables are strings (run by sh) used for fzf reloads.
tab=$'\t'
sessions_cmd="tmux list-sessions -F '#{session_name}${tab}#{session_path}' 2>/dev/null || true"

printf -v home_q '%q' "$HOME"
if command -v fd >/dev/null 2>&1; then
  # fd ignores hidden files and .gitignore entries: fast and clean.
  anywhere_cmd="fd --type d --max-depth $any_depth . $home_q"
else
  anywhere_cmd="find $home_q -mindepth 1 -maxdepth $any_depth -name '.*' -prune -o -name node_modules -prune -o -type d -print 2>/dev/null"
fi
roots_q=()
for d in "${roots[@]}"; do
  printf -v q '%q' "$d"
  roots_q+=("$q")
done
if (( ${#roots_q[@]} )); then
  projects_cmd="find ${roots_q[*]} -mindepth 1 -maxdepth 1 -type d 2>/dev/null"
else
  projects_cmd=":"   # no roots: no-op
fi

# --- Pick with fzf --------------------------------------------------------
# Session lines are "name<TAB>path"; folder lines are plain paths.
selected=$(
  eval "$sessions_cmd" \
  | fzf --height=60% --reverse --prompt="session > " \
      --header="ctrl-s: sessions · ctrl-t: projects · ctrl-a: all \$HOME" \
      --bind "ctrl-s:change-prompt(session > )+reload($sessions_cmd)" \
      --bind "ctrl-t:change-prompt(project > )+reload($projects_cmd)" \
      --bind "ctrl-a:change-prompt(folder > )+reload($anywhere_cmd)" \
  || true
)

[[ -z "$selected" ]] && exit 0

if [[ "$selected" == *"$tab"* ]]; then
  # Existing session: just switch to it.
  name=${selected%%"$tab"*}
  session_exists=1
else
  # Folder: build a valid session name (tmux does not allow '.' or ':').
  name=$(basename "$selected" | tr '.:' '__')
  if tmux has-session -t "$name" 2>/dev/null; then
    session_exists=1
  else
    tmux new-session -d -s "$name" -c "$selected"
    session_exists=0
  fi
fi

# Inside tmux switch the client; outside, attach to the session.
if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "$name"
else
  tmux attach -t "$name"
fi

# `session_exists` is kept in case you want to extend the script
# (e.g. open extra windows only the first time).
: "$session_exists"
